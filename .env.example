# ===================================================================
# OpenRouter API
# ===================================================================
OPENROUTER_API_KEY=sk-or-v1-ВАШ_КЛЮЧ_OPENROUTER
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Модель и температура для синхронизации файлов (compare_columns и т.п.)
AI_MODEL=google/gemini-3-flash-preview
AI_TEMPERATURE=0.1

# ===================================================================
# AI-агент маппинга PIM+FDM (v6.0)
# ===================================================================
# Bearer-токен внешнего REST API /v1/mapping-tasks.
# ПУСТО = агент ВЫКЛЮЧЕН (маршруты /v1/* отвечают 503, бот и сайт
# работают как раньше). Сгенерировать:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Тот же токен передаётся команде FDM как FDM_AI_AGENT_API_KEY.
FDM_API_TOKEN=

# Модель и температура ДЛЯ ЗАДАНИЙ МАППИНГА (пусто = AI_MODEL/AI_TEMPERATURE)
AGENT_AI_MODEL=
AGENT_AI_TEMPERATURE=0.1

# Воркер агента
AGENT_MAX_CONCURRENT_JOBS=3      # параллельных заданий
AGENT_POLL_INTERVAL_SEC=5        # опрос очереди при пустой БД
AGENT_JOB_TIMEOUT_SEC=240        # таймаут одного задания (fail → failed)
AGENT_JOBS_RETENTION_DAYS=30     # хранение завершённых заданий в БД

# Лимиты валидатора payload (защита от перегрузки промпта;
# значения по умолчанию — см. config.py, здесь можно переопределить)
AGENT_MAX_ATTRIBUTES=100
AGENT_MAX_CHANNELS=20
AGENT_MAX_CHANNEL_ATTRIBUTES=500
AGENT_MAX_REFERENCE_VALUES=1000
AGENT_MAX_REFERENCE_CHANNEL_VALUES=2000

# ===================================================================
# Telegram Bot
# ===================================================================
TELEGRAM_BOT_TOKEN=ВАШ_ТОКЕН_БОТА

PROXY_ENABLED=false
PROXY_URL=http://user:password@proxy-host:port

# Администратирование
ACCESS_OWNER_ID=0
ACCESS_ADMIN_ID=0

# ===================================================================
# PostgreSQL — основная база данных (обязательно!)
# ===================================================================
# Формат: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://bot_user:secret@localhost:5432/marketplace_sync

# Размер пула соединений (по умолчанию: min=2, max=10)
DATABASE_POOL_MIN_SIZE=2
DATABASE_POOL_MAX_SIZE=10

# ===================================================================
# Redis — хранилище FSM-состояний и кэш (опционально)
# ===================================================================
REDIS_URL=redis://localhost:6379/0

# ===================================================================
# Логирование (опционально)
# ===================================================================
LOG_FILE_PATH=./logs/app.log
LOG_LEVEL=INFO

# Очередь задач (опционально)
MAX_CONCURRENT_TASKS=5
TASK_QUEUE_KEY=bot:task_queue

# Файлы
UPLOAD_DIR=/root/progect/uploads
DOWNLOAD_DIR=/root/progect/downloads
OUTPUT_DIR=/root/progect/output
FILE_MAX_AGE_DAYS=7

# ===================================================================
# Веб-интерфейс
# ===================================================================
WEB_HOST=127.0.0.1
WEB_PORT=8080
WEB_DOMAIN=ecommpedia.ru
WEB_SECRET_KEY=СГЕНЕРИРУЙТЕ_64_HEX_СИМВОЛА
WEB_SESSION_MAX_AGE=86400
WEB_REGISTRATION_OPEN=false
WEB_CSRF_ENABLED=true
